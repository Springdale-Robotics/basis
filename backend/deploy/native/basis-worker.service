[Unit]
Description=Basis background worker (BullMQ jobs)
Documentation=https://github.com/Springdale-Robotics/basis
After=network-online.target postgresql.service redis-server.service basis.service
Wants=network-online.target
Requires=postgresql.service redis-server.service
# Unattended appliance: never latch into a permanent failed state. See the
# matching note in basis.service. StartLimit* only take effect under [Unit].
StartLimitIntervalSec=0

[Service]
Type=simple
User=basis
Group=basis
WorkingDirectory=/opt/basis/current/backend
EnvironmentFile=/opt/basis/.env
# Pinned, not inherited. All-day events are stored as a wall-clock instant and
# converted to Google's exclusive `end.date` at the sync boundary, and that
# conversion distinguishes a Basis-authored end (noon) from a provider-supplied
# one (exact UTC midnight). At a host offset of exactly +/-12 local noon IS UTC
# midnight and the two become indistinguishable; at |offset| >= 13 the date
# arithmetic shifts a day. Boxes are self-hosted and set to local time, so this
# cannot be left to whatever the host happens to be.
Environment=TZ=UTC
ExecStart=/usr/bin/node dist/worker.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
