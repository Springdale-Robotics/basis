# ============================================
# REQUIRED - Application will not start without these
# ============================================

# Database connection string
DATABASE_URL=postgresql://user:password@localhost:5432/homemanager

# Redis connection string
REDIS_URL=redis://localhost:6379

# Secret for session encryption (minimum 32 characters)
SESSION_SECRET=your-super-secret-session-key-minimum-32-chars

# Secret for encrypting sensitive data at rest (32 bytes, hex-encoded)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ============================================
# OPTIONAL - Defaults provided
# ============================================

# Environment
NODE_ENV=production
LOG_LEVEL=info

# Server
HOST=0.0.0.0
PORT=3000
WEBSOCKET_PORT=3001

# Security
CORS_ORIGINS=
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Database
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false

# Session
SESSION_MAX_AGE_MS=604800000

# File Storage
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=100

# ============================================
# EXTERNAL INTEGRATIONS (Optional)
# ============================================

# Google Calendar Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft/Outlook Integration
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Cloudflare Tunnel (if using)
CLOUDFLARE_TUNNEL_TOKEN=

# Spotify Integration
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ============================================
# FEATURE FLAGS
# ============================================

ENABLE_AI_FEATURES=false
ENABLE_SMART_HOME=true
ENABLE_DLNA_SERVER=true
ENABLE_METRICS=true

# ============================================
# DEVELOPMENT ONLY
# ============================================

# DEBUG=*
# DISABLE_RATE_LIMIT=true
# DISABLE_CSRF=true
# Allow user-driven outbound fetches (recipe URL/image import) to reach
# private/loopback addresses. Off by default (SSRF guard); dev-only.
# SSRF_ALLOW_PRIVATE=true

# The admin Terminal page opens a freeform shell as the backend user (host-level
# access). Default true for the single-owner-admin install. Set false to disable
# it — required on any install serving more than one household. See SECURITY.md.
# ENABLE_ADMIN_TERMINAL=false

# Off-host backup copy. Runs after each nightly DB backup so it doesn't live only
# on the same disk as the database. The backup file is in $BASIS_BACKUP_FILE, the
# backup dir in $BASIS_BACKUP_DIR, and uploaded media in $BASIS_STORAGE_DIR (media
# is NOT in the DB dump — include it here to back it up too).
# BACKUP_REMOTE_CMD='rclone copy "$BASIS_BACKUP_FILE" remote:basis-backups/ && rclone sync "$BASIS_STORAGE_DIR" remote:basis-media/'
